{
  "name": "tj-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently -k -n srv,css,js \"tsx watch --clear-screen=false src/server.ts\" \"npm:build:css -- --watch\" \"node scripts/build-client.mjs --watch\"",
    "build": "npm run build:css && node scripts/build-client.mjs && tsc -p tsconfig.build.json",
    "build:css": "tailwindcss -i src/styles/app.css -o public/assets/app.css --minify",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed/index.ts",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@tailwindcss/cli": "^4.3.5",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.2",
    "chart.js": "^4.6.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "ejs": "^7.0.2",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "lucide-static": "^1.75.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.0",
    "otplib": "^13.6.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.2",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/sortablejs": "^1.15.9",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "satori": {
      "fflate": "^0.7.5"
    },
    "esbuild": "$esbuild"
  }
}
