<h1 class="text-display-md">Reset password</h1>
<% if (locals.sent) { %>
  <div class="alert alert-success mt-6 text-sm" role="status">If that email belongs to an admin account, a reset link is on its way. It expires in 30 minutes.</div>
  <a class="btn btn-ghost mt-6" href="<%= A('/login') %>"><%- icon('arrow-left','size-4') %> Back to sign in</a>
<% } else { %>
  <p class="mt-2 text-muted">Enter your admin email and we'll send a single-use reset link.</p>
  <form method="post" class="mt-8 grid gap-5">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field"><label class="label" for="email">Email</label><input class="input" id="email" name="email" type="email" autocomplete="username" required autofocus></div>
    <button class="btn btn-primary w-full" type="submit">Send reset link</button>
    <a class="text-center text-sm text-muted hover:underline" href="<%= A('/login') %>">Back to sign in</a>
  </form>
<% } %>
