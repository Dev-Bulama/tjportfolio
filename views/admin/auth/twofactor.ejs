<h1 class="text-display-md">Two-factor check</h1>
<p class="mt-2 text-muted">Enter the 6-digit code from your authenticator app, or one of your recovery codes.</p>
<% if (locals.error) { %><div class="alert alert-danger mt-6 text-sm" role="alert"><%= error %></div><% } %>
<form method="post" class="mt-8 grid gap-5">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="next" value="<%= next %>">
  <div class="field"><label class="label" for="code">Code</label><input class="input text-center font-mono text-lg tracking-[0.3em]" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" required autofocus maxlength="40"></div>
  <button class="btn btn-primary w-full" type="submit">Verify</button>
</form>
<form method="post" action="<%= A('/logout') %>" class="mt-4 text-center"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-sm text-muted underline-offset-4 hover:underline">Use a different account</button></form>
