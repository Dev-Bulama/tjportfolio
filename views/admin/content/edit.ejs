<%
  const base = A('/content/' + def.key);
  const main = def.fields.filter(f => !f.section);
  const sections = [...new Set(def.fields.filter(f => f.section).map(f => f.section))];
  const title = values[def.titleField];
  const status = values.status || 'draft';
%>
<%- include('../../partials/admin/page-head', {
  title: id ? (title || 'Untitled') : 'New ' + def.singular.toLowerCase(),
  crumbs: [[def.label, base], [id ? 'Edit' : 'New', null]],
}) %>

<% if (Object.keys(errors).length) { %>
  <div class="alert alert-danger mb-6 text-sm" role="alert" tabindex="-1" data-error-summary>
    <p class="font-semibold text-ink">Please fix the following:</p>
    <ul class="mt-2 list-disc pl-5"><% for (const [k, msg] of Object.entries(errors)) { %><li><a class="underline" href="#field-<%= k %>"><%= msg %></a></li><% } %></ul>
  </div>
<% } %>

<form method="post" action="<%= id ? base + '/' + id : base + '/new' %>" class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_20rem]" data-editor data-autosave="<%= (!id || status === 'draft') && !readOnly ? '1' : '0' %>" data-title-field="<%= def.titleField %>" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <fieldset class="grid min-w-0 content-start gap-6" <%= readOnly ? 'disabled' : '' %>>
    <section class="card grid gap-5 p-5 md:p-6 md:grid-cols-6">
      <% for (const f of main) { %><%- include('../../partials/admin/fields/field', { f }) %><% } %>
    </section>
    <% for (const sec of sections) { %>
      <section class="card p-5 md:p-6" aria-labelledby="sec-<%= slugify(sec) %>">
        <h2 id="sec-<%= slugify(sec) %>" class="mb-5 font-display text-lg text-ink"><%= sec %></h2>
        <div class="grid gap-5 md:grid-cols-6">
          <% for (const f of def.fields.filter(x => x.section === sec)) { %><%- include('../../partials/admin/fields/field', { f }) %><% } %>
        </div>
      </section>
    <% } %>
    <% if (def.seo) { %>
      <section class="card p-5 md:p-6" aria-labelledby="sec-seo">
        <h2 id="sec-seo" class="font-display text-lg text-ink">Search & sharing</h2>
        <p class="help mt-1">Leave empty to use the title and summary.</p>
        <div class="mt-5 grid gap-5 md:grid-cols-6">
          <%- include('../../partials/admin/fields/field', { f: { name: 'seoTitle', label: 'SEO title', type: 'text', max: 191, help: 'Ideally under 60 characters.' } }) %>
          <%- include('../../partials/admin/fields/field', { f: { name: 'seoDescription', label: 'Meta description', type: 'textarea', rows: 2, max: 320, help: 'Ideally 120–160 characters.' } }) %>
          <%- include('../../partials/admin/fields/field', { f: { name: 'ogImageId', label: 'Social share image (defaults to a generated image)', type: 'image', accept: 'image' } }) %>
        </div>
      </section>
    <% } %>
  </fieldset>

  <aside class="grid content-start gap-6 xl:sticky xl:top-20">
    <section class="card p-5" aria-labelledby="pub-h">
      <h2 id="pub-h" class="font-display text-lg text-ink"><%= def.status ? 'Publish' : 'Save' %></h2>
      <fieldset class="mt-4 grid gap-4" <%= readOnly ? 'disabled' : '' %>>
        <% if (def.status) { %>
          <div class="field" id="field-status"><label class="label" for="status">Status</label>
            <select class="select" id="status" name="status" data-status-select>
              <option value="draft" <%= status === 'draft' ? 'selected' : '' %>>Draft (hidden)</option>
              <option value="published" <%= status === 'published' ? 'selected' : '' %>>Published</option>
              <option value="scheduled" <%= status === 'scheduled' ? 'selected' : '' %>>Scheduled</option>
            </select>
          </div>
          <div class="field" id="field-publishedAt" data-publish-at <%= status === 'draft' ? 'hidden' : '' %>>
            <label class="label" for="publishedAt">Publish date (UTC)</label>
            <input class="input" type="datetime-local" id="publishedAt" name="publishedAt" value="<%= values.publishedAt || '' %>" <% if (errors.publishedAt) { %>aria-invalid="true"<% } %>>
            <% if (errors.publishedAt) { %><p class="error-text"><%= errors.publishedAt %></p><% } %>
          </div>
        <% } %>
        <% if (def.featured) { %>
          <label class="flex items-center gap-2 text-sm"><input type="hidden" name="featured" value="0"><input type="checkbox" class="checkbox" name="featured" value="1" <%= values.featured ? 'checked' : '' %>> Featured</label>
        <% } %>
        <% if (def.sample) { %>
          <div id="field-isSample">
            <label class="flex items-start gap-2 text-sm"><input type="hidden" name="isSample" value="0"><input type="checkbox" class="checkbox mt-0.5" name="isSample" value="1" <%= values.isSample ? 'checked' : '' %>> <span><strong class="text-ink">Sample / placeholder</strong><br><span class="text-muted">Never shown publicly. Untick once this is real, verified content.</span></span></label>
            <% if (errors.isSample) { %><p class="error-text mt-1"><%= errors.isSample %></p><% } %>
          </div>
        <% } %>
      </fieldset>
      <div class="mt-5 flex flex-wrap gap-2">
        <% if (!readOnly) { %><button class="btn btn-primary btn-sm flex-1" type="submit" data-save><%- icon('save','size-4') %> Save</button><% } %>
        <% if (publicUrl) { %><a class="btn btn-outline btn-sm" href="<%= base %>/<%= id %>/preview" target="_blank" rel="noopener"><%- icon('eye','size-4') %> Preview</a><% } %>
      </div>
      <p class="mt-3 text-xs text-muted" data-autosave-status aria-live="polite"><% if (id && values.updatedAt) { %>Last saved <%= timeAgo(values.updatedAt) %><% } %></p>
      <% if (id && !readOnly) { %>
        <div class="mt-4 flex gap-2 border-t border-line pt-4">
          <% if (def.canCreate !== false) { %><button class="btn btn-ghost btn-xs" formaction="<%= base %>/<%= id %>/duplicate" formnovalidate data-no-guard><%- icon('copy','size-3.5') %> Duplicate</button><% } %>
          <% if (def.trash && def.canDelete !== false) { %><button class="btn btn-ghost btn-xs ml-auto text-danger" formaction="<%= base %>/<%= id %>/trash" formnovalidate data-no-guard data-confirm="Move this <%= def.singular.toLowerCase() %> to trash?"><%- icon('trash-2','size-3.5') %> Trash</button><% } %>
        </div>
      <% } %>
    </section>
    <% if (id && history.length) { %>
      <section class="card p-5" aria-labelledby="hist-h">
        <h2 id="hist-h" class="font-display text-lg text-ink">History</h2>
        <ol class="mt-3 grid gap-3 text-sm">
          <% for (const h of history) { %>
            <li class="border-l-2 border-line pl-3">
              <p class="text-ink"><span class="font-semibold"><%= h.userName || 'System' %></span> <%= h.action.replace(/_/g, ' ') %></p>
              <p class="text-xs text-muted"><%= timeAgo(h.createdAt) %><% if (h.diff) { %> · <%= Object.keys(h.diff).slice(0,4).join(', ') %><%= Object.keys(h.diff).length > 4 ? '…' : '' %><% } %></p>
            </li>
          <% } %>
        </ol>
      </section>
    <% } %>
  </aside>
</form>
<%- include('../../partials/admin/media-picker') %>
<script type="application/json" id="block-defs" nonce="<%= nonce %>"><%- json(blocks) %></script>
