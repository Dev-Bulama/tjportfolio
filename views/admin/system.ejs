<%- include('../partials/admin/page-head', { title: 'System', subtitle: 'Health checks and maintenance tools.' }) %>
<div class="grid gap-6 lg:grid-cols-2">
  <section class="card p-6"><h2 class="font-display text-lg text-ink">Status</h2>
    <dl class="mt-4 grid grid-cols-2 gap-y-2 text-sm">
      <dt class="text-muted">Node</dt><dd class="text-ink"><%= info.node %> (<%= info.env %>)</dd>
      <dt class="text-muted">Uptime</dt><dd class="text-ink"><%= Math.round(info.uptime / 60) %> min</dd>
      <dt class="text-muted">Memory</dt><dd class="text-ink"><%= info.memory %> MB</dd>
      <dt class="text-muted">Cached entries</dt><dd class="text-ink"><%= info.cache %></dd>
      <dt class="text-muted">Admin path</dt><dd class="font-mono text-ink">/<%= info.adminPath %></dd>
      <dt class="text-muted">Storage</dt><dd class="text-ink"><%= info.driver %> — <span class="<%= storage && storage.ok ? 'text-teal' : 'text-danger' %>"><%= storage ? storage.detail : 'unchecked' %></span></dd>
      <dt class="text-muted">Files by driver</dt><dd class="text-ink"><%= mediaCounts.map(m => m.driver + ': ' + m.n).join(', ') || 'none' %></dd>
      <dt class="text-muted">Image processing</dt><dd class="<%= sharp.error ? 'text-danger' : 'text-ink' %>"><%= sharp.error ? 'unavailable — ' + sharp.error : sharp.loaded ? 'sharp loaded' : 'loads on first upload' %></dd>
      <dt class="text-muted">Latest migration</dt><dd class="text-ink"><%= migrations.length ? '#' + migrations[0].id + ' · ' + new Date(Number(migrations[0].created_at)).toISOString().slice(0,10) : 'none' %></dd>
    </dl>
  </section>
  <section class="card p-6"><h2 class="font-display text-lg text-ink">Tools</h2>
    <form method="post" class="mt-4 grid gap-2 sm:grid-cols-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button formaction="<%= A('/system/migrate') %>" class="btn btn-outline btn-sm justify-start"><%- icon('database','size-4') %> Run migrations</button>
      <button formaction="<%= A('/system/storage') %>" class="btn btn-outline btn-sm justify-start"><%- icon('hard-drive','size-4') %> Re-check storage</button>
      <button formaction="<%= A('/system/cache') %>" class="btn btn-outline btn-sm justify-start"><%- icon('refresh-cw','size-4') %> Clear page cache</button>
      <button formaction="<%= A('/system/jobs') %>" class="btn btn-outline btn-sm justify-start"><%- icon('mail','size-4') %> Retry email queue</button>
      <button formaction="<%= A('/system/rollup') %>" class="btn btn-outline btn-sm justify-start"><%- icon('line-chart','size-4') %> Roll up analytics</button>
      <button formaction="<%= A('/system/copy-to-s3') %>" class="btn btn-outline btn-sm justify-start" <%= info.s3 ? '' : 'disabled' %> data-confirm="Copy local uploads to S3 and switch them to the S3 driver?"><%- icon('cloud-upload','size-4') %> Copy local media → S3</button>
    </form>
  </section>
  <section class="card p-6 lg:col-span-2"><h2 class="font-display text-lg text-ink">Email queue</h2>
    <% if (!jobs.length) { %><p class="mt-3 text-sm text-muted">Nothing waiting. All emails have been delivered.</p><% } else { %>
    <div class="mt-3 overflow-x-auto"><table class="table"><thead><tr><th>Queued</th><th>To</th><th>Subject</th><th>Attempts</th><th>Status</th><th>Last error</th></tr></thead><tbody>
      <% jobs.forEach(j => { %><tr><td class="text-muted"><%= timeAgo(j.createdAt) %></td><td><%= j.payload.to %></td><td><%= j.payload.content && j.payload.content.subject %></td><td><%= j.attempts %></td><td><span class="chip <%= j.status === 'failed' ? 'chip-danger' : 'chip-gold' %>"><%= j.status %></span></td><td class="max-w-xs truncate text-xs text-muted" title="<%= j.lastError %>"><%= j.lastError %></td></tr><% }) %>
    </tbody></table></div><% } %>
  </section>
</div>
