<%- include('../partials/admin/page-head', { title: 'Analytics', subtitle: 'Privacy-friendly and cookieless: no raw IPs are stored and staff visits are excluded.', actions: `<a class="btn btn-outline btn-sm" href="${A('/analytics')}${qs({ range, from: range === 'custom' ? from : undefined, to: range === 'custom' ? to : undefined }, { export: 'csv' })}">${icon('download','size-4')} Export CSV</a>` }) %>
<form method="get" class="mb-6 flex flex-wrap items-end gap-2">
  <% [['1','Today'],['7','7 days'],['30','30 days'],['90','90 days']].forEach(([v,l]) => { %><a href="?range=<%= v %>" class="chip <%= range === v ? 'chip-navy' : '' %>"><%= l %></a><% }) %>
  <input type="hidden" name="range" value="custom">
  <label class="sr-only" for="from">From</label><input class="input !w-auto !py-1.5 text-sm" type="date" id="from" name="from" value="<%= from %>">
  <label class="sr-only" for="to">To</label><input class="input !w-auto !py-1.5 text-sm" type="date" id="to" name="to" value="<%= to %>">
  <button class="btn btn-outline btn-xs">Apply</button>
</form>
<ul class="grid grid-cols-2 gap-4 lg:grid-cols-4">
  <li class="card p-5"><p class="text-sm text-muted">Visitors</p><p class="stat-num mt-2 text-3xl"><%= formatNumber(totals.visitors) %></p></li>
  <li class="card p-5"><p class="text-sm text-muted">Page views</p><p class="stat-num mt-2 text-3xl"><%= formatNumber(totals.views) %></p></li>
  <li class="card p-5"><p class="text-sm text-muted">Views / visitor</p><p class="stat-num mt-2 text-3xl"><%= totals.visitors ? (totals.views / totals.visitors).toFixed(1) : '0' %></p></li>
  <li class="card p-5"><p class="text-sm text-muted">Contact submissions</p><p class="stat-num mt-2 text-3xl"><%= (events.find(e => e.key === 'contact_submit') || { n: 0 }).n %></p></li>
</ul>
<section class="card mt-6 p-5"><h2 class="font-display text-lg text-ink">Visitors & page views</h2><div class="mt-4 h-72"><canvas data-chart="line" role="img" aria-label="Visitors and page views per day"></canvas></div>
  <script type="application/json" data-chart-data nonce="<%= nonce %>"><%- json({ labels: series.map(r => String(r.day).slice(0,10)), datasets: [{ label: 'Page views', data: series.map(r => Number(r.views)) }, { label: 'Visitors', data: series.map(r => Number(r.visitors)) }] }) %></script>
</section>
<% const table = (title, rows, empty) => { %>
  <section class="card p-5"><h2 class="font-display text-lg text-ink"><%= title %></h2>
    <% if (!rows.length) { %><p class="mt-3 text-sm text-muted"><%= empty || 'No data for this period.' %></p><% } else { const max = Math.max(...rows.map(r => Number(r.n))); %>
    <ol class="mt-3 grid gap-1.5 text-sm"><% rows.forEach(r => { %><li class="relative flex justify-between gap-3 rounded px-2 py-1"><span class="absolute inset-y-0 left-0 rounded bg-surface-2" style="width:<%= Math.max(4, Number(r.n) / max * 100) %>%" aria-hidden="true"></span><span class="relative truncate text-ink"><%= r.key || '(direct)' %></span><span class="relative tabular-nums text-muted"><%= r.n %></span></li><% }) %></ol><% } %>
  </section>
<% }; %>
<div class="mt-6 grid gap-6 lg:grid-cols-3">
  <% table('Top pages', pages) %>
  <% table('Top projects', projects, 'No project views yet.') %>
  <% table('Referrers', refs, 'Mostly direct traffic.') %>
  <% table('Countries', countries, 'Country needs a proxy header such as Cloudflare\'s CF-IPCountry.') %>
  <% table('UTM campaigns', utm, 'No tagged campaigns.') %>
  <section class="card p-5"><h2 class="font-display text-lg text-ink">Devices</h2><% if (devices.length) { %><div class="mt-3 h-48"><canvas data-chart="doughnut" role="img" aria-label="Visits by device"></canvas></div><script type="application/json" data-chart-data nonce="<%= nonce %>"><%- json({ labels: devices.map(d => d.key), datasets: [{ label: 'Views', data: devices.map(d => Number(d.n)) }] }) %></script><% } else { %><p class="mt-3 text-sm text-muted">No data.</p><% } %></section>
  <% table('Browsers', browsers) %>
  <% table('Operating systems', oses) %>
  <section class="card p-5"><h2 class="font-display text-lg text-ink">Events</h2>
    <% if (!events.length) { %><p class="mt-3 text-sm text-muted">No events yet.</p><% } else { %>
    <ol class="mt-3 grid gap-1.5 text-sm"><% events.forEach(e => { %><li class="flex justify-between gap-3"><span class="text-ink"><%= String(e.key).replace(/_/g,' ') %></span><span class="tabular-nums text-muted"><%= e.n %> <span class="text-xs">(<%= e.uniq %> people)</span></span></li><% }) %></ol><% } %>
  </section>
</div>
<section class="card mt-6 p-5"><h2 class="font-display text-lg text-ink">Funnel: visit → contact</h2>
  <ol class="mt-4 grid gap-3 sm:grid-cols-3"><% funnel.forEach(([l, v], i) => { const pct = funnel[0][1] ? (v / funnel[0][1] * 100) : 0; %><li class="rounded-xl border border-line p-4"><p class="text-sm text-muted"><%= i + 1 %>. <%= l %></p><p class="stat-num mt-1 text-2xl"><%= formatNumber(v) %></p><div class="mt-2 h-1.5 rounded-full bg-line"><div class="h-1.5 rounded-full bg-gold" style="width:<%= Math.min(100, pct) %>%"></div></div><p class="mt-1 text-xs text-muted"><%= pct.toFixed(1) %>% of visitors</p></li><% }) %></ol>
</section>
