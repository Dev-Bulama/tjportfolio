<%- include('../../partials/admin/page-head', { title: 'Set up two-factor authentication', subtitle: forced ? 'Required for the Owner account. This takes about a minute.' : 'Adds a second step when you sign in.' }) %>
<div class="card grid max-w-3xl gap-8 p-6 md:grid-cols-[220px_1fr] md:p-8">
  <div class="mx-auto w-[200px] rounded-xl border border-line bg-white p-2"><%- qr %></div>
  <div>
    <ol class="grid gap-3 text-sm">
      <li><strong class="text-ink">1.</strong> Open your authenticator app and scan the QR code.</li>
      <li><strong class="text-ink">2.</strong> Can't scan? Enter this key manually:<br><code class="mt-1 inline-block break-all rounded bg-surface-2 px-2 py-1 font-mono text-[0.8rem] text-ink"><%= secret.match(/.{1,4}/g).join(' ') %></code></li>
      <li><strong class="text-ink">3.</strong> Enter the 6-digit code the app shows.</li>
    </ol>
    <form method="post" class="mt-6 flex flex-wrap items-end gap-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label class="label" for="code">Code</label><input class="input w-44 text-center font-mono text-lg tracking-[0.25em]" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required autofocus></div>
      <button class="btn btn-primary">Verify & enable</button>
    </form>
  </div>
</div>
