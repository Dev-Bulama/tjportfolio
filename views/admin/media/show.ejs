<%- include('../../partials/admin/page-head', { title: m.originalName, crumbs: [['Media library', A('/media')], ['File', null]] }) %>
<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
  <div class="card grid min-h-80 place-items-center overflow-hidden bg-surface-2 p-4">
    <% if (isImage(m)) { %><img src="<%= mediaUrl(m, 1280) %>" alt="<%= m.alt || '' %>" class="max-h-[70vh] w-auto rounded-lg" width="<%= m.width || '' %>" height="<%= m.height || '' %>">
    <% } else { %><a class="btn btn-outline" href="<%= mediaUrl(m) %>" target="_blank" rel="noopener"><%- icon('file-text','size-4') %> Open PDF</a><% } %>
  </div>
  <div class="grid content-start gap-6">
    <form method="post" action="<%= A('/media/' + m.id) %>" class="card grid gap-4 p-5">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label class="label" for="alt">Alt text <% if (isImage(m)) { %><span class="text-danger">*</span><% } %></label><textarea class="textarea !min-h-0" rows="2" id="alt" name="alt" maxlength="255" <%= isImage(m) ? 'required' : '' %>><%= m.alt || '' %></textarea><p class="help">Describe what the image shows for people using screen readers.</p></div>
      <div class="field"><label class="label" for="caption">Caption</label><input class="input" id="caption" name="caption" value="<%= m.caption || '' %>" maxlength="500"></div>
      <div class="field"><label class="label" for="credit">Photographer credit</label><input class="input" id="credit" name="credit" value="<%= m.credit || '' %>" maxlength="191"></div>
      <button class="btn btn-primary btn-sm">Save details</button>
    </form>
    <div class="card p-5 text-sm">
      <dl class="grid grid-cols-2 gap-y-2">
        <dt class="text-muted">Type</dt><dd class="text-ink"><%= m.mime %></dd>
        <dt class="text-muted">Size</dt><dd class="text-ink"><%= (m.size/1024).toFixed(0) %> KB</dd>
        <% if (m.width) { %><dt class="text-muted">Dimensions</dt><dd class="text-ink"><%= m.width %>×<%= m.height %></dd><% } %>
        <dt class="text-muted">Variants</dt><dd class="text-ink"><%= (m.variants || []).map(v => v.width).join(', ') || '—' %></dd>
        <dt class="text-muted">Storage</dt><dd class="text-ink"><%= m.driver %></dd>
        <dt class="text-muted">Uploaded</dt><dd class="text-ink"><%= formatDate(m.createdAt, 'short') %></dd>
        <% if (album) { %><dt class="text-muted">Album</dt><dd><a class="underline" href="<%= A('/content/albums/' + album.id) %>"><%= album.title %></a></dd><% } %>
      </dl>
      <div class="mt-3 flex gap-2"><input class="input !py-1 font-mono text-xs" value="<%= mediaUrl(m) %>" readonly aria-label="File URL" data-select-on-focus></div>
    </div>
    <div class="card p-5 text-sm">
      <h2 class="font-display text-lg text-ink">Where it's used</h2>
      <% if (!usages.length && !album) { %><p class="mt-2 text-muted">Not used anywhere.</p><% } else { %>
        <ul class="mt-2 grid gap-1"><% for (const u of usages) { %><li><a class="underline" href="<%= A('/content/' + u.resource + '/' + u.resourceId) %>"><%= u.resource %> #<%= u.resourceId %></a> <span class="text-muted">· <%= u.field %></span></li><% } %></ul>
      <% } %>
    </div>
    <form method="post" action="<%= A('/media/' + m.id + '/replace') %>?_csrf=<%= csrfToken %>" enctype="multipart/form-data" class="card grid gap-3 p-5 text-sm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="label" for="replace">Replace file (keeps all references)</label>
      <input id="replace" type="file" name="file" class="text-sm" accept="<%= isImage(m) ? 'image/*' : 'application/pdf' %>" required>
      <button class="btn btn-outline btn-sm">Upload replacement</button>
    </form>
    <% if (m.deletedAt) { %>
      <div class="flex gap-2">
        <form method="post" action="<%= A('/media/' + m.id + '/restore') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline btn-sm">Restore</button></form>
        <form method="post" action="<%= A('/media/' + m.id + '/destroy') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-sm text-danger" data-confirm="Permanently delete this file?<%= usages.length ? ' It is used in ' + usages.length + ' place(s) — those will show nothing.' : '' %>">Delete permanently</button></form>
      </div>
    <% } else { %>
      <form method="post" action="<%= A('/media/' + m.id + '/trash') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-sm text-danger" data-confirm="<%= usages.length ? 'This file is used in ' + usages.length + ' place(s). Move it to trash anyway?' : 'Move this file to trash?' %>"><%- icon('trash-2','size-4') %> Move to trash</button></form>
    <% } %>
  </div>
</div>
