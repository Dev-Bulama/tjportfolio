<%- include('../../partials/admin/page-head', { title: 'Subscribers', subtitle: 'Newsletter sign-ups with double opt-in. Only confirmed subscribers are exported by default.', actions: `<a class="btn btn-outline btn-sm" href="${A('/subscribers')}${qs({ status }, { export: 'csv' })}">${icon('download','size-4')} Export CSV</a>` }) %>
<nav class="mb-4 flex gap-1 text-sm"><% [['','All'],['confirmed','Confirmed'],['pending','Pending'],['unsubscribed','Unsubscribed']].forEach(([v,l]) => { %><a href="<%= A('/subscribers') %><%= v ? '?status=' + v : '' %>" class="rounded-full px-3 py-1.5 <%= status === v ? 'bg-surface-2 font-semibold text-ink' : 'text-muted hover:text-ink' %>"><%= l %></a><% }) %></nav>
<% if (!rows.length) { %><div class="card px-6 py-16 text-center"><p class="font-display text-xl text-ink">No subscribers yet</p><p class="mt-1 text-sm text-muted">The signup form is in the site footer.</p></div><% } else { %>
<div class="card overflow-x-auto"><table class="table"><thead><tr><th>Email</th><th>Status</th><th class="hidden md:table-cell">Signed up</th><th class="hidden md:table-cell">Confirmed</th><th></th></tr></thead><tbody>
<% rows.forEach(r => { %><tr><td class="text-ink"><%= r.email %></td><td><%- include('../../partials/admin/status-badge', { value: r.status === 'confirmed' ? 'published' : r.status === 'pending' ? 'pending' : 'draft' }) %></td><td class="hidden md:table-cell text-muted"><%= formatDate(r.createdAt, 'short') %></td><td class="hidden md:table-cell text-muted"><%= r.confirmedAt ? formatDate(r.confirmedAt, 'short') : '—' %></td>
<td class="text-right"><% if (r.status !== 'unsubscribed') { %><form method="post" action="<%= A('/subscribers/' + r.id + '/remove') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-xs text-danger" data-confirm="Unsubscribe <%= r.email %>?">Unsubscribe</button></form><% } %></td></tr><% }) %>
</tbody></table></div><% } %>
