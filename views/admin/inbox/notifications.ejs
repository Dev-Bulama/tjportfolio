<%- include('../../partials/admin/page-head', { title: 'Notifications', subtitle: 'Everything waiting for you.' }) %>
<div class="grid gap-6 lg:grid-cols-3">
  <section class="card p-5"><h2 class="font-display text-lg text-ink">New messages (<%= messages.length %>)</h2><ul class="mt-3 divide-y divide-line text-sm"><% messages.forEach(m => { %><li class="py-2"><a class="text-ink hover:underline" href="<%= A('/inbox/' + m.id) %>"><%= m.name %> — <%= m.inquiryType %></a><span class="block text-xs text-muted"><%= timeAgo(m.createdAt) %></span></li><% }) %><% if (!messages.length) { %><li class="py-2 text-muted">All caught up.</li><% } %></ul></section>
  <section class="card p-5"><h2 class="font-display text-lg text-ink">Open tickets (<%= tickets.length %>)</h2><ul class="mt-3 divide-y divide-line text-sm"><% tickets.forEach(t => { %><li class="py-2"><a class="text-ink hover:underline" href="<%= A('/tickets/' + t.id) %>"><%= t.ticketNo %> · <%= t.priority %></a><span class="block text-xs text-muted"><%= labels[t.status] %> · <%= timeAgo(t.createdAt) %></span></li><% }) %><% if (!tickets.length) { %><li class="py-2 text-muted">No open tickets.</li><% } %></ul></section>
  <section class="card p-5"><h2 class="font-display text-lg text-ink">Reviews to moderate (<%= reviews.length %>)</h2><ul class="mt-3 divide-y divide-line text-sm"><% reviews.forEach(r => { %><li class="py-2"><a class="text-ink hover:underline" href="<%= A('/content/testimonials/' + r.id) %>"><%= r.authorName %> · <%= r.rating %>★</a><span class="block text-xs text-muted"><%= r.consent ? 'Consented' : 'No consent' %> · <%= timeAgo(r.createdAt) %></span></li><% }) %><% if (!reviews.length) { %><li class="py-2 text-muted">Nothing pending.</li><% } %></ul></section>
</div>
