<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%= subject %></title></head>
<body style="margin:0;padding:0;background:#F8F6F1;font-family:Inter,Segoe UI,Helvetica,Arial,sans-serif;color:#33414F;">
<% if (locals.preheader) { %><div style="display:none;max-height:0;overflow:hidden;opacity:0"><%= preheader %></div><% } %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F8F6F1;padding:32px 12px;">
<tr><td align="center">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;">
    <tr><td style="padding:0 4px 20px 4px;">
      <span style="display:inline-block;width:36px;height:36px;line-height:36px;text-align:center;border:1px solid #B8925A;border-radius:50%;font-family:Georgia,serif;font-weight:600;color:#0B1A2B;">TB</span>
      <span style="font-family:Georgia,serif;font-size:18px;color:#0B1A2B;padding-left:10px;vertical-align:middle;">Tijani Bulama</span>
    </td></tr>
    <tr><td style="background:#FFFFFF;border:1px solid #E4DFD4;border-radius:12px;padding:32px 28px;">
      <div style="height:2px;width:48px;background:#B8925A;margin-bottom:22px;"></div>
      <h1 style="margin:0 0 16px 0;font-family:Georgia,'Times New Roman',serif;font-weight:500;font-size:24px;line-height:1.25;color:#0B1A2B;"><%= heading %></h1>
      <% for (const p of paragraphs) { %><p style="margin:0 0 14px 0;font-size:15px;line-height:1.65;"><%= p %></p><% } %>
      <% if (locals.quote) { %><blockquote style="margin:18px 0;padding:12px 16px;border-left:2px solid #B8925A;background:#F8F6F1;font-size:15px;line-height:1.6;color:#0B1A2B;white-space:pre-wrap;"><%= quote %></blockquote><% } %>
      <% if (locals.details && details.length) { %>
        <table role="presentation" cellpadding="0" cellspacing="0" style="margin:16px 0;width:100%;font-size:14px;">
          <% for (const [k, v] of details) { %><tr><td style="padding:6px 0;color:#5F6A78;width:35%;"><%= k %></td><td style="padding:6px 0;color:#0B1A2B;font-weight:600;"><%= v %></td></tr><% } %>
        </table>
      <% } %>
      <% if (locals.button) { %>
        <p style="margin:24px 0 8px 0;"><a href="<%= button.url %>" style="display:inline-block;background:#0F2A47;color:#F3EFE6;text-decoration:none;font-weight:600;font-size:15px;padding:12px 22px;border-radius:999px;"><%= button.label %></a></p>
        <p style="margin:8px 0 0 0;font-size:12px;color:#5F6A78;word-break:break-all;">Or paste this link: <%= button.url %></p>
      <% } %>
      <% if (locals.footnote) { %><p style="margin:20px 0 0 0;font-size:13px;color:#5F6A78;"><%= footnote %></p><% } %>
    </td></tr>
    <tr><td style="padding:18px 4px;font-size:12px;color:#5F6A78;line-height:1.6;">
      Tijani Bulama · Lagos, Nigeria · <a href="<%= appUrl %>" style="color:#5F6A78;"><%= appUrl.replace(/^https?:\/\//, '') %></a><br>© <%= year %>
    </td></tr>
  </table>
</td></tr></table>
</body></html>
