<%# locals: p (ProjectCard), i %>
<article class="card card-hover group relative flex h-full flex-col overflow-hidden reveal" style="--i:<%= locals.i || 0 %>" data-project data-category="<%= p.category ? p.category.slug : '' %>" data-title="<%= p.title.toLowerCase() %> <%= (p.summary||'').toLowerCase() %> <%= p.tech.join(' ').toLowerCase() %>" data-tags="<%= p.tech.join('|').toLowerCase() %>" data-year="<%= p.year || 0 %>" data-order="<%= p.sortOrder %>">
  <div class="zoom-img relative aspect-[16/10] bg-surface-2">
    <% if (p.cover) { %>
      <%- img(p.cover, { aspect: '16/10', sizes: '(min-width:1024px) 380px, (min-width:640px) 50vw, 100vw', alt: p.cover.alt || p.title }) %>
    <% } else { %>
      <div class="flex h-full items-end bg-navy p-5" aria-hidden="true">
        <span class="font-display text-[2.4rem] leading-none text-navy-ink/90"><%= initials(p.title) %></span>
        <span class="ml-auto"><%- icon(p.category && p.category.slug === 'ai-automation' ? 'bot' : p.category && p.category.slug === 'oracle-db' ? 'database' : p.category && p.category.slug === 'courseware' ? 'book-open' : 'layers', 'size-7 text-gold') %></span>
      </div>
    <% } %>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <div class="flex flex-wrap items-center gap-2">
      <% if (p.category) { %><span class="mono-label"><%= p.category.name %></span><% } %>
      <% if (p.projectStatus !== 'completed') { %><span class="chip chip-teal"><%= p.projectStatus === 'ongoing' ? 'Ongoing' : 'Concept' %></span><% } %>
    </div>
    <h3 class="mt-3 text-display-sm"><a href="/work/<%= p.slug %>" class="after:absolute after:inset-0"><%= p.title %></a></h3>
    <p class="mt-3 line-clamp-3 text-[0.95rem]"><%= p.summary %></p>
    <% if (p.tech.length) { %>
      <ul class="mt-auto flex flex-wrap gap-1.5 pt-5" aria-label="Tech stack">
        <% p.tech.slice(0,4).forEach(t => { %><li class="chip"><%= t %></li><% }) %>
      </ul>
    <% } %>
  </div>
</article>
