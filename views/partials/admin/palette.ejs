<dialog id="palette" class="modal !max-w-xl self-start !mt-[12vh]" aria-label="Command palette">
  <div class="overflow-hidden rounded-2xl border border-line bg-surface shadow-2xl">
    <div class="flex items-center gap-3 border-b border-line px-4">
      <%- icon('search', 'size-4 text-muted') %>
      <label for="palette-input" class="sr-only">Search pages, content and actions</label>
      <input id="palette-input" type="text" autocomplete="off" spellcheck="false" placeholder="Search pages, content and actions…" class="w-full bg-transparent py-4 text-[0.95rem] text-ink outline-none" role="combobox" aria-expanded="true" aria-controls="palette-list" aria-autocomplete="list">
      <kbd class="rounded border border-line px-1.5 font-mono text-[0.7rem] text-muted">Esc</kbd>
    </div>
    <ul id="palette-list" role="listbox" class="max-h-[50vh] overflow-y-auto p-2" data-palette-list></ul>
    <p class="border-t border-line px-4 py-2 text-xs text-muted">↑↓ to move · Enter to open · type to search content</p>
  </div>
  <script type="application/json" id="palette-data" nonce="<%= nonce %>"><%- json(paletteItems) %></script>
</dialog>
