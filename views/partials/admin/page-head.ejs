<%# locals: title, subtitle, crumbs [[label, href]], actions (html) %>
<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div class="min-w-0">
    <% if (locals.crumbs && crumbs.length) { %>
      <nav aria-label="Breadcrumb" class="mb-2 text-sm text-muted"><ol class="flex flex-wrap items-center gap-1.5">
        <% crumbs.forEach(([label, href], i) => { %><li class="flex items-center gap-1.5"><% if (href) { %><a href="<%= href %>" class="hover:text-ink hover:underline"><%= label %></a><% } else { %><span aria-current="page"><%= label %></span><% } %><% if (i < crumbs.length - 1) { %><span aria-hidden="true">/</span><% } %></li><% }) %>
      </ol></nav>
    <% } %>
    <h1 class="truncate text-display-md"><%= title %></h1>
    <% if (locals.subtitle) { %><p class="mt-1.5 text-muted"><%= subtitle %></p><% } %>
  </div>
  <% if (locals.actions) { %><div class="flex flex-wrap gap-2"><%- actions %></div><% } %>
</div>
