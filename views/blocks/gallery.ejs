<% if (b.images.length) { %><section class="container-x py-12"><ul class="masonry"><% b.images.forEach((m, j) => { %><li><a href="<%= mediaUrl(m, 1920) %>" data-lightbox="block-<%= i %>" data-caption="<%= m.caption || '' %>" data-alt="<%= m.alt || '' %>" class="zoom-img block overflow-hidden rounded-[12px]"><%- img(m, { sizes: '(min-width:1024px) 380px, 50vw' }) %></a></li><% }) %></ul></section><% } %>
