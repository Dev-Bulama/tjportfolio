<% if (b.faqs.length) { %><section class="container-x py-12"><h2 class="text-display-md"><%= b.d.title %></h2><div class="mt-6 divide-y divide-line border-y border-line"><% b.faqs.forEach(f => { %><details class="faq group py-5"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg text-ink"><%= f.question %><span class="text-gold transition-transform group-open:rotate-45"><%- icon('plus','size-5') %></span></summary><p class="mt-3 max-w-2xl"><%= f.answer %></p></details><% }) %></div></section><% } %>
