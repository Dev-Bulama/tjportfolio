<% if (b.stats.length) { %><section class="my-10 border-y border-line bg-surface"><% if (b.d.title) { %><h2 class="container-x pt-8 mono-label"><%= b.d.title %></h2><% } %><dl class="container-x grid grid-cols-2 md:grid-cols-<%= Math.min(b.stats.length, 4) %>"><% b.stats.forEach(s => { %><div class="px-2 py-8"><dt class="mono-label"><%= s.label %></dt><dd class="stat-num mt-2 text-[2.6rem] leading-none"><span data-count="<%= s.value %>"><%= formatNumber(s.value) %></span><span class="text-gold-ink"><%= s.suffix || '' %></span></dd></div><% }) %></dl></section><% } %>
