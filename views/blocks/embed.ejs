<% if (b.src) { %><section class="container-x max-w-4xl py-10"><div class="<%= b.d.kind === 'calendly' ? 'aspect-[3/4] md:aspect-[4/3]' : 'aspect-video' %> overflow-hidden rounded-[12px] border border-line bg-surface-2"><button type="button" class="grid size-full place-items-center text-ink" data-embed-src="<%= b.src %>" data-embed-title="<%= b.d.title || 'Embedded content' %>"><span class="btn btn-outline"><%- icon(b.d.kind === 'youtube' ? 'circle-play' : b.d.kind === 'map' ? 'map' : 'calendar-clock','size-4') %> Load <%= b.d.kind === 'youtube' ? 'video' : b.d.kind === 'map' ? 'map' : 'booking calendar' %></span></button></div></section><% } %>
