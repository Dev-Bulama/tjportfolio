<section class="container-x max-w-3xl py-12">
  <h2 class="text-display-md"><%= b.d.title %></h2><% if (b.d.intro) { %><p class="mt-3"><%= b.d.intro %></p><% } %>
  <div data-form-success tabindex="-1" hidden></div>
  <form method="post" action="/contact" enctype="multipart/form-data" class="mt-8 grid gap-5 sm:grid-cols-2" data-ajax-form data-event="contact_submit">
    <%- include('../partials/site/antispam') %>
    <input type="hidden" name="page" value="/<%= page.slug %>">
    <input type="hidden" name="inquiryType" value="Other">
    <%- include('../partials/site/field', { name: 'name', label: 'Name', required: true, autocomplete: 'name' }) %>
    <%- include('../partials/site/field', { name: 'email', label: 'Email', type: 'email', required: true, autocomplete: 'email' }) %>
    <%- include('../partials/site/field', { name: 'message', label: 'Message', type: 'textarea', required: true, cls: 'sm:col-span-2' }) %>
    <div class="sm:col-span-2"><button class="btn btn-primary" type="submit">Send</button></div>
    <p class="text-sm sm:col-span-2" data-form-status role="status" aria-live="polite"></p>
  </form>
</section>
