<%- include('../partials/site/page-hero', { kicker: 'Services', title: 'Build the system. Train the team.', lede: 'Six ways I work with organisations — from shipping production software and AI automation to equipping teams with the skills to run it.' }) %>
<section class="container-x grid gap-6 md:grid-cols-2">
  <% services.forEach((s, i) => { %>
    <a href="/services/<%= s.slug %>" class="card card-hover group flex flex-col p-8 reveal" style="--i:<%= i % 2 %>">
      <div class="flex items-center justify-between"><span class="grid size-12 place-items-center rounded-full border border-line text-gold-ink group-hover:border-gold"><%- icon(s.icon || 'sparkles','size-5') %></span><span class="mono-label">0<%= i + 1 %></span></div>
      <h2 class="mt-8 text-display-md"><%= s.title %></h2>
      <p class="mt-4 text-[1rem]"><%= s.summary %></p>
      <% if ((s.deliverables || []).length) { %><ul class="mt-6 grid gap-2 text-sm"><% s.deliverables.slice(0,3).forEach(d => { %><li class="flex gap-2"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-gold"></span><%= d %></li><% }) %></ul><% } %>
      <span class="mt-auto inline-flex items-center gap-2 pt-8 font-medium text-ink">Explore <%= s.title.toLowerCase() %> <%- icon('arrow-right','size-4 transition-transform group-hover:translate-x-1') %></span>
    </a>
  <% }) %>
</section>
<% if (faqs.length) { %>
<section class="container-x py-24" aria-labelledby="faq-h">
  <div class="grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-4"><p class="kicker">FAQ</p><h2 id="faq-h" class="mt-4 text-display-lg">Common questions</h2></div>
    <div class="divide-y divide-line border-y border-line lg:col-span-8">
      <% for (const f of faqs) { %><details class="group py-5"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg text-ink"><%= f.question %><span class="text-gold transition-transform group-open:rotate-45"><%- icon('plus','size-5') %></span></summary><p class="mt-3 max-w-2xl"><%= f.answer %></p></details><% } %>
    </div>
  </div>
</section>
<% } %>
