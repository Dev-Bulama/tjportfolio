<section class="container-x pb-6 pt-10 md:pt-16">
  <div class="flex flex-col gap-6 border-b border-line pb-10 md:flex-row md:items-end md:justify-between">
    <div><p class="kicker">Resume</p><h1 class="mt-4 text-display-xl"><%= profile.fullName %></h1><p class="mt-3 text-lede"><%= profile.headline %></p>
      <p class="mt-3 text-sm text-muted"><%= [profile.location, contactEmail, pub(profile.phone)].filter(Boolean).join('  ·  ') %></p></div>
    <div class="no-print flex flex-wrap gap-2">
      <% if (cvs.length) { %><% cvs.forEach(c => { %><a href="/cv/<%= c.id %>" class="btn <%= c.isPrimary ? 'btn-primary' : 'btn-outline' %>"><%- icon('download','size-4') %> <%= c.title %></a><% }) %>
      <% } else { %><a href="/cv/generated.pdf" class="btn btn-primary"><%- icon('download','size-4') %> Download PDF</a><% } %>
      <button type="button" class="btn btn-ghost" data-print-page><%- icon('printer','size-4') %> Print</button>
    </div>
  </div>
</section>
<div class="container-x grid gap-12 py-8 lg:grid-cols-12">
  <div class="lg:col-span-8">
    <h2 class="mono-label !text-gold-ink">Profile</h2><p class="mt-3 text-[1.02rem]"><%= profile.shortBio %></p>
    <h2 class="mono-label mt-12 !text-gold-ink">Experience</h2>
    <ol class="mt-4 grid gap-8">
      <% experiences.forEach(e => { const period = e.startDate || e.endDate ? periodLabel(e.startDate, e.endDate, e.isCurrent) : (e.periodLabel || (e.isCurrent ? 'Present' : '')); %>
        <li class="grid gap-1 sm:grid-cols-[1fr_auto]"><div><h3 class="font-display text-xl text-ink"><%= e.role %></h3><p class="text-ink"><%= e.organization %><%= e.location ? ' · ' + e.location : '' %></p><% if (e.description) { %><p class="mt-2 text-[0.95rem]"><%= e.description %></p><% } %></div><p class="mono-label sm:text-right"><%= period %></p></li>
      <% }) %>
    </ol>
    <% if (trainings.length) { %>
      <h2 class="mono-label mt-12 !text-gold-ink">Trainings delivered</h2>
      <ul class="mt-4 grid gap-2 text-[0.95rem]"><% trainings.forEach(t => { %><li><a class="text-ink hover:underline" href="/training/<%= t.slug %>"><%= t.title %></a><span class="text-muted"><%= [t.client, t.durationLabel].filter(Boolean).length ? ' — ' + [t.client, t.durationLabel].filter(Boolean).join(' · ') : '' %></span></li><% }) %></ul>
    <% } %>
  </div>
  <aside class="grid content-start gap-10 lg:col-span-4">
    <div><h2 class="mono-label !text-gold-ink">Skills</h2><dl class="mt-4 grid gap-4 text-[0.92rem]"><% for (const [cat, list] of skillGroups) { %><div><dt class="font-semibold text-ink"><%= skillLabel(cat) %></dt><dd class="mt-1"><%= list.map(k => k.name).join(', ') %></dd></div><% } %></dl></div>
    <% if (certs.length) { %><div><h2 class="mono-label !text-gold-ink">Certifications</h2><ul class="mt-4 grid gap-2 text-[0.92rem]"><% certs.forEach(c => { %><li><a class="text-ink hover:underline" href="/certifications/<%= c.slug %>"><%= c.name %></a> <span class="text-muted">— <%= c.issuer %></span></li><% }) %></ul></div><% } %>
    <% if (education.length) { %><div><h2 class="mono-label !text-gold-ink">Education</h2><ul class="mt-4 grid gap-2 text-[0.92rem]"><% education.forEach(e => { %><li><span class="text-ink"><%= e.qualification %></span><br><span class="text-muted"><%= e.institution %><%= e.endYear ? ', ' + e.endYear : '' %></span></li><% }) %></ul></div><% } %>
  </aside>
</div>
