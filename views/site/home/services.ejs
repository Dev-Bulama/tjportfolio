<% if (services.length) { %>
<section class="container-x py-20 md:py-28" aria-labelledby="sec-services">
  <%- include('../../partials/site/section-head', { kicker: sec.kicker, title: sec.title, intro: sec.intro || 'Two halves of one job: building software that works in production, and building the skills of the people who run it.', link: '/services', linkLabel: 'All services', id: 'sec-services' }) %>
  <div class="grid gap-px overflow-hidden rounded-[12px] border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
    <% services.forEach((s, i) => { %>
      <a href="/services/<%= s.slug %>" class="group flex flex-col bg-surface p-7 transition-colors hover:bg-surface-2 reveal" style="--i:<%= i %>">
        <span class="grid size-11 place-items-center rounded-full border border-line text-gold-ink transition group-hover:border-gold"><%- icon(s.icon || 'sparkles', 'size-5') %></span>
        <h3 class="mt-6 text-display-sm"><%= s.title %></h3>
        <p class="mt-3 text-[0.95rem]"><%= s.summary %></p>
        <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-ink">Learn more <%- icon('arrow-right', 'size-4 transition-transform group-hover:translate-x-1') %></span>
      </a>
    <% }) %>
  </div>
</section>
<% } %>
