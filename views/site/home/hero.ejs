<section class="relative overflow-hidden" aria-labelledby="hero-title">
  <div class="container-x grid items-center gap-12 pb-16 pt-10 md:pt-16 lg:grid-cols-12 lg:gap-10 lg:pb-24">
    <div class="lg:col-span-7">
      <p class="kicker"><%= profile.location %></p>
      <h1 id="hero-title" class="mt-6 text-display-xl"><%= profile.fullName %><span class="text-gold-ink">.</span></h1>
      <p class="mt-6 max-w-2xl font-display text-[clamp(1.35rem,1.1rem+1vw,2rem)] italic leading-snug text-ink"><%= profile.positioning %></p>
      <p class="mt-5 max-w-xl text-[1.05rem] text-body"><%= profile.headline %></p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/contact" class="btn btn-primary">Hire me / Book a consultation <%- icon('arrow-right', 'size-4') %></a>
        <a href="/work" class="btn btn-outline">View work</a>
      </div>
      <p class="mt-8 inline-flex items-center gap-2 text-sm text-body">
        <span class="relative flex size-2.5"><span class="absolute inline-flex h-full w-full animate-ping rounded-full <%= profile.availabilityStatus === 'available' ? 'bg-teal' : 'bg-gold' %> opacity-60"></span><span class="relative inline-flex size-2.5 rounded-full <%= profile.availabilityStatus === 'available' ? 'bg-teal' : 'bg-gold' %>"></span></span>
        <%= profile.availabilityStatus === 'booked' && profile.bookedUntil ? 'Booked until ' + profile.bookedUntil : profile.availability %>
      </p>
    </div>
    <div class="lg:col-span-5">
      <div class="relative mx-auto max-w-sm lg:max-w-none">
        <div class="absolute -left-4 -top-4 h-full w-full rounded-[18px] border border-gold/60" aria-hidden="true"></div>
        <% if (brand.portrait) { %>
          <div class="relative overflow-hidden rounded-[16px] bg-surface-2 <%= settings.branding.duotonePortrait ? 'duotone' : '' %>">
            <%- img(brand.portrait, { aspect: '4/5', eager: true, sizes: '(min-width:1024px) 440px, 90vw', alt: brand.portrait.alt || 'Portrait of ' + profile.fullName }) %>
          </div>
        <% } else { %>
          <div class="relative flex aspect-[4/5] flex-col justify-between overflow-hidden rounded-[16px] bg-navy p-8 text-navy-ink" role="img" aria-label="<%= profile.fullName %> monogram">
            <span class="mono-label !text-[#9fb0c4]">Est. Lagos</span>
            <span class="font-display text-[9rem] leading-[0.8] tracking-tight sm:text-[11rem]">TJ<span class="text-gold">.</span></span>
            <span class="font-display text-xl italic text-[#d9dee6]">Engineer · Trainer · Founder</span>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>
