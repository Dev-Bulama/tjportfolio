<% if (certs.length) { %>
<section class="container-x py-20" aria-labelledby="sec-certs">
  <%- include('../../partials/site/section-head', { kicker: sec.kicker, title: sec.title, link: '/certifications', linkLabel: 'All certifications', id: 'sec-certs' }) %>
  <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
    <% certs.slice(0, 6).forEach((c, i) => { %>
      <li class="reveal" style="--i:<%= i %>"><a href="/certifications/<%= c.slug %>" class="card card-hover flex h-full flex-col items-center p-5 text-center">
        <% if (c.logo) { %><%- img(c.logo, { cls: 'h-14 w-14', imgCls: 'h-14 w-14 object-contain', sizes: '56px', alt: '' }) %><% } else { %><span class="grid size-14 place-items-center rounded-full bg-surface-2 text-gold-ink"><%- icon('award', 'size-6') %></span><% } %>
        <span class="mt-3 text-sm font-semibold leading-snug text-ink"><%= c.name %></span>
        <span class="mt-1 text-xs text-muted"><%= c.issuer %></span>
      </a></li>
    <% }) %>
  </ul>
</section>
<% } %>
