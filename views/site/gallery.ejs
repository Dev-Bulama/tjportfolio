<%- include('../partials/site/page-hero', { kicker: 'Gallery', title: 'In the room', lede: 'Training sessions, labs, events and launches.' }) %>
<section class="container-x">
  <% const withPhotos = albums.filter(a => a.count > 0); %>
  <% if (!withPhotos.length) { %>
    <div class="card px-6 py-16 text-center"><p class="font-display text-2xl text-ink">Photos are being curated.</p><p class="mt-3">Albums from bootcamps, labs and events will appear here soon.</p></div>
  <% } else { %>
  <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    <% withPhotos.forEach((a, i) => { %>
      <a href="/gallery/<%= a.slug %>" class="group block reveal" style="--i:<%= i % 3 %>">
        <div class="zoom-img overflow-hidden rounded-[12px] border border-line bg-surface-2"><% if (a.cover) { %><%- img(a.cover, { aspect: '4/3', sizes: '(min-width:1024px) 380px, 50vw', alt: a.cover.alt || a.title }) %><% } else { %><div class="aspect-[4/3]"></div><% } %></div>
        <div class="mt-4 flex items-baseline justify-between gap-3"><h2 class="font-display text-xl text-ink group-hover:underline"><%= a.title %></h2><span class="mono-label"><%= a.count %> photo<%= a.count === 1 ? '' : 's' %></span></div>
        <% if (a.description) { %><p class="mt-1 line-clamp-2 text-sm"><%= a.description %></p><% } %>
      </a>
    <% }) %>
  </div>
  <% } %>
</section>
