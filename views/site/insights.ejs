<%- include('../partials/site/page-hero', { kicker: 'Insights', title: 'Notes from the work', lede: 'On AI agents and automation, databases, engineering practice and training that changes how teams work.' }) %>
<section class="container-x">
  <% if (cats.length) { %>
    <nav class="mb-10 flex flex-wrap gap-2" aria-label="Categories">
      <a href="/insights" class="chip <%= !cat ? 'chip-navy' : '' %>" <%= !cat ? 'aria-current=page' : '' %>>All</a>
      <% cats.forEach(c => { %><a href="/insights?category=<%= c.slug %>" class="chip <%= cat === c.slug ? 'chip-navy' : '' %>" <%= cat === c.slug ? 'aria-current=page' : '' %>><%= c.name %></a><% }) %>
      <a href="/rss.xml" class="chip ml-auto"><%- icon('rss','size-3.5') %> RSS</a>
    </nav>
  <% } %>
  <% if (tag) { %><p class="mb-6 text-sm">Tagged <strong class="text-ink">#<%= tag %></strong> · <a class="underline" href="/insights">clear</a></p><% } %>
  <% if (!posts.length) { %>
    <div class="card px-6 py-16 text-center"><p class="font-display text-2xl text-ink">The first articles are in the edit.</p><p class="mt-3">Subscribe to the newsletter in the footer to get them when they're published.</p></div>
  <% } else { %>
    <% const [lead, ...rest] = posts; %>
    <a href="/insights/<%= lead.slug %>" class="group mb-16 grid items-center gap-8 md:grid-cols-2">
      <div class="zoom-img overflow-hidden rounded-[16px] border border-line bg-surface-2"><% if (lead.cover) { %><%- img(lead.cover, { aspect: '3/2', eager: true, sizes: '(min-width:768px) 560px, 100vw', alt: lead.cover.alt || '' }) %><% } else { %><div class="flex aspect-[3/2] items-end bg-navy p-8"><span class="font-display text-7xl italic text-gold">“</span></div><% } %></div>
      <div><p class="mono-label !text-gold-ink"><%= lead.category ? lead.category.name : 'Insight' %> · <%= lead.readingMinutes %> min read</p><h2 class="mt-3 text-display-lg group-hover:underline"><%= lead.title %></h2><p class="mt-4 text-lede !text-[1.1rem]"><%= lead.excerpt %></p><p class="mt-4 text-sm text-muted"><%= formatDate(lead.publishedAt) %></p></div>
    </a>
    <div class="grid gap-x-8 gap-y-14 md:grid-cols-3"><% rest.forEach((p, i) => { %><%- include('../partials/site/post-card', { p, i: i % 3 }) %><% }) %></div>
  <% } %>
</section>
