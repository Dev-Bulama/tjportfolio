<%- include('../partials/site/page-hero', { kicker: 'Service', title: s.title, lede: s.summary, crumbs: [['Home','/'],['Services','/services'],[s.title, null]] }) %>
<% if (s.status !== 'published') { %><div class="container-x"><p class="alert mb-8 text-sm">Preview — this service is not published.</p></div><% } %>
<div class="container-x grid gap-14 lg:grid-cols-12">
  <div class="lg:col-span-7"><div class="prose"><%- s.bodyHtml %></div></div>
  <aside class="lg:col-span-5">
    <% if ((s.deliverables || []).length) { %>
      <div class="card p-7"><h2 class="mono-label !text-gold-ink">What you get</h2>
        <ul class="mt-5 grid gap-3"><% s.deliverables.forEach(d => { %><li class="flex gap-3 text-[0.95rem]"><span class="mt-0.5 text-teal"><%- icon('check','size-4') %></span><span class="text-ink"><%= d %></span></li><% }) %></ul>
        <a href="/contact?type=<%= encodeURIComponent(s.slug.includes('training') ? 'Corporate training' : s.slug.includes('oracle') ? 'Oracle Database' : s.slug.includes('six') ? 'Lean Six Sigma' : s.slug.includes('ai') ? 'AI & automation' : s.slug.includes('courseware') ? 'Courseware' : 'Software project') %>&subject=<%= encodeURIComponent(s.title) %>" class="btn btn-primary mt-7 w-full"><%= s.ctaText || 'Start a conversation' %> <%- icon('arrow-right','size-4') %></a>
      </div>
    <% } %>
  </aside>
</div>
<% if ((s.process || []).length) { %>
<section class="container-x py-20" aria-labelledby="proc-h">
  <%- include('../partials/site/section-head', { kicker: 'Process', title: 'How it works', id: 'proc-h' }) %>
  <ol class="grid gap-px overflow-hidden rounded-[12px] border border-line bg-line md:grid-cols-<%= Math.min(s.process.length, 4) %>">
    <% s.process.forEach((p, i) => { %><li class="bg-surface p-7 reveal" style="--i:<%= i %>"><span class="stat-num text-4xl text-gold-ink">0<%= i + 1 %></span><h3 class="mt-4 text-display-sm"><%= p.title %></h3><p class="mt-3 text-[0.95rem]"><%= p.description %></p></li><% }) %>
  </ol>
</section>
<% } %>
<% if (s.projects.length) { %>
<section class="container-x py-12" aria-labelledby="rel-h">
  <%- include('../partials/site/section-head', { kicker: 'Related work', title: 'Selected projects', link: '/work', id: 'rel-h' }) %>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"><% s.projects.slice(0,3).forEach((p, i) => { %><%- include('../partials/site/project-card', { p, i }) %><% }) %></div>
</section>
<% } %>
<% if (s.reviews.length) { %>
<section class="container-x py-12" aria-labelledby="rev-h">
  <%- include('../partials/site/section-head', { kicker: 'Testimonials', title: 'What clients say', link: '/testimonials', id: 'rev-h' }) %>
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3"><% s.reviews.slice(0,3).forEach((r, i) => { %><%- include('../partials/site/review-card', { r, i }) %><% }) %></div>
</section>
<% } %>
<% if (s.faqs.length) { %>
<section class="container-x py-16" aria-labelledby="sfaq-h">
  <div class="grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-4"><p class="kicker">FAQ</p><h2 id="sfaq-h" class="mt-4 text-display-lg">Questions</h2></div>
    <div class="divide-y divide-line border-y border-line lg:col-span-8">
      <% for (const f of s.faqs) { %><details class="group py-5"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg text-ink"><%= f.question %><span class="text-gold transition-transform group-open:rotate-45"><%- icon('plus','size-5') %></span></summary><p class="mt-3 max-w-2xl"><%= f.answer %></p></details><% } %>
    </div>
  </div>
</section>
<% } %>
<% if (others.length) { %>
<section class="container-x pb-8 pt-12"><p class="mono-label">Other services</p><ul class="mt-4 flex flex-wrap gap-2"><% others.forEach(o => { %><li><a class="chip hover:border-gold" href="/services/<%= o.slug %>"><%= o.title %></a></li><% }) %></ul></section>
<% } %>
<%- include('home/cta', { sec: { kicker: 'Next step', title: 'Let\'s scope it together.', intro: '' } }) %>
