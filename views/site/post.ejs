<article>
  <header class="container-x pb-10 pt-10 md:pt-16">
    <nav aria-label="Breadcrumb" class="mb-8 text-sm text-muted"><a class="link-grow hover:text-ink" href="/insights">← Insights</a></nav>
    <% if (p.status !== 'published') { %><p class="alert mb-6 text-sm">Preview — this post is <%= p.status %>.</p><% } %>
    <p class="kicker"><%= p.category ? p.category.name : 'Insight' %></p>
    <h1 class="mt-5 max-w-4xl text-display-xl"><%= p.title %></h1>
    <% if (p.excerpt) { %><p class="mt-6 max-w-3xl text-lede"><%= p.excerpt %></p><% } %>
    <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted">
      <span class="text-ink"><%= p.authorName || profile.fullName %></span><span aria-hidden="true">·</span>
      <% if (p.publishedAt) { %><time datetime="<%= new Date(p.publishedAt).toISOString() %>"><%= formatDate(p.publishedAt) %></time><span aria-hidden="true">·</span><% } %>
      <span><%= p.readingMinutes %> min read</span>
    </div>
  </header>
  <% if (p.cover) { %><div class="container-x"><%- img(p.cover, { cls: 'rounded-[16px] border border-line', aspect: '16/9', eager: true, sizes: '(min-width:1024px) 1024px, 100vw', alt: p.cover.alt || '' }) %></div><% } %>
  <div class="container-x mt-12 grid gap-12 lg:grid-cols-[1fr_16rem]">
    <div class="prose mx-auto lg:mx-0"><%- p.bodyHtml %></div>
    <aside class="no-print order-first lg:order-none">
      <div class="lg:sticky lg:top-28">
        <% if (p.toc.length > 2) { %>
          <nav class="toc rounded-[12px] border border-line p-5 text-sm" aria-label="Table of contents"><p class="mono-label">Contents</p><ol class="mt-3 grid gap-2"><% p.toc.forEach(t => { %><li class="<%= t.level === 3 ? 'pl-3' : '' %>"><a class="text-body hover:text-ink" href="#<%= t.id %>"><%= t.text %></a></li><% }) %></ol></nav>
        <% } %>
        <div class="mt-6 text-sm"><p class="mono-label">Share</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <a class="btn btn-ghost btn-icon border border-line" href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(appUrl + '/insights/' + p.slug) %>" target="_blank" rel="noopener" aria-label="Share on LinkedIn"><%- icon('linkedin','size-4') %></a>
            <a class="btn btn-ghost btn-icon border border-line" href="https://x.com/intent/post?url=<%= encodeURIComponent(appUrl + '/insights/' + p.slug) %>&text=<%= encodeURIComponent(p.title) %>" target="_blank" rel="noopener" aria-label="Share on X"><%- icon('x','size-4') %></a>
            <a class="btn btn-ghost btn-icon border border-line" href="https://wa.me/?text=<%= encodeURIComponent(p.title + ' ' + appUrl + '/insights/' + p.slug) %>" target="_blank" rel="noopener" aria-label="Share on WhatsApp"><%- icon('whatsapp','size-4') %></a>
            <button type="button" class="btn btn-ghost btn-sm border border-line" data-copy-link>Copy link</button>
          </div>
        </div>
      </div>
    </aside>
  </div>
  <% if (p.tags.length) { %><div class="container-x mt-10"><ul class="flex flex-wrap gap-2"><% p.tags.forEach(t => { %><li><a class="chip" href="/insights?tag=<%= t.slug %>">#<%= t.name %></a></li><% }) %></ul></div><% } %>
  <div class="container-x mt-14">
    <div class="card flex flex-col gap-5 p-6 sm:flex-row sm:items-center">
      <% if (brand.portrait) { %><%- img(brand.portrait, { cls: 'size-16 shrink-0 overflow-hidden rounded-full', imgCls: 'size-16 object-cover', sizes: '64px', alt: '' }) %><% } else { %><span class="grid size-16 shrink-0 place-items-center rounded-full bg-navy font-display text-xl text-navy-ink">TB</span><% } %>
      <div><p class="font-display text-lg text-ink"><%= profile.fullName %></p><p class="mt-1 text-sm"><%= profile.headline %></p></div>
      <a href="/about" class="btn btn-outline btn-sm sm:ml-auto">About TJ</a>
    </div>
  </div>
</article>
<% if (p.related.length) { %>
<section class="container-x mt-20" aria-labelledby="rel-h"><h2 id="rel-h" class="text-display-md">Keep reading</h2><div class="mt-8 grid gap-x-8 gap-y-12 md:grid-cols-3"><% p.related.forEach((r, i) => { %><%- include('../partials/site/post-card', { p: r, i }) %><% }) %></div></section>
<% } %>
