<section class="container-x grid gap-12 pb-16 pt-10 md:pt-16 lg:grid-cols-12">
  <div class="lg:col-span-7">
    <p class="kicker">About</p>
    <h1 class="mt-5 text-display-xl">Engineer. Trainer. <span class="italic text-gold-ink">Founder.</span></h1>
    <p class="mt-6 text-lede"><%= profile.headline %></p>
    <div class="mt-10 prose"><%- longBio %></div>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/resume" class="btn btn-primary"><%- icon('file-text','size-4') %> View resume</a>
      <a href="<%= hasCv ? '/cv' : '/cv/generated.pdf' %>" class="btn btn-outline" data-track="cv_download"><%- icon('download','size-4') %> Download CV</a>
    </div>
  </div>
  <aside class="lg:col-span-5">
    <div class="sticky top-28">
      <div class="relative">
        <div class="absolute -left-4 -top-4 h-full w-full rounded-[18px] border border-gold/60" aria-hidden="true"></div>
        <% if (brand.portrait) { %>
          <div class="relative overflow-hidden rounded-[16px] <%= settings.branding.duotonePortrait ? 'duotone' : '' %>"><%- img(brand.portrait, { aspect: '4/5', eager: true, sizes: '(min-width:1024px) 420px, 90vw', alt: brand.portrait.alt || 'Portrait of ' + profile.fullName }) %></div>
        <% } else { %>
          <div class="relative flex aspect-[4/5] flex-col justify-end rounded-[16px] bg-navy p-8 text-navy-ink" role="img" aria-label="<%= profile.fullName %> monogram"><span class="font-display text-[8rem] leading-[0.8]">TJ<span class="text-gold">.</span></span></div>
        <% } %>
      </div>
      <dl class="mt-8 grid grid-cols-2 gap-5 text-sm">
        <div><dt class="mono-label">Based in</dt><dd class="mt-1 text-ink"><%= profile.location %></dd></div>
        <div><dt class="mono-label">Works</dt><dd class="mt-1 text-ink">Across Africa & remotely</dd></div>
        <div class="col-span-2"><dt class="mono-label">Availability</dt><dd class="mt-1 text-ink"><%= profile.availabilityStatus === 'booked' && profile.bookedUntil ? 'Booked until ' + profile.bookedUntil : profile.availability %></dd></div>
      </dl>
    </div>
  </aside>
</section>

<% if (leadership.length) { %>
<section class="bg-surface-2/60 py-20" aria-labelledby="lead-h">
  <div class="container-x">
    <%- include('../partials/site/section-head', { kicker: 'Leadership', title: 'Organizations I lead', id: 'lead-h' }) %>
    <div class="grid gap-6 md:grid-cols-3">
      <% leadership.forEach((e, i) => { %>
        <article class="card flex flex-col p-7 reveal" style="--i:<%= i %>">
          <% if (e.logo) { %><%- img(e.logo, { cls: 'h-12 w-auto', imgCls: 'h-12 w-auto object-contain', sizes: '120px', alt: e.organization }) %><% } else { %><span class="grid size-12 place-items-center rounded-full border border-gold font-display text-ink"><%= initials(e.organization) %></span><% } %>
          <h3 class="mt-5 text-display-sm"><%= e.organization %></h3>
          <p class="mono-label mt-2"><%= e.role %></p>
          <p class="mt-4 text-[0.95rem]"><%= e.description %></p>
          <% if (safeUrl(e.url)) { %><a href="<%= safeUrl(e.url) %>" class="mt-auto pt-5 text-sm font-medium text-ink underline decoration-gold underline-offset-4" target="_blank" rel="noopener">Visit website</a><% } %>
        </article>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="container-x py-20" aria-labelledby="career-h">
  <div class="grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4"><p class="kicker">Career</p><h2 id="career-h" class="mt-4 text-display-lg">Timeline</h2><p class="mt-4 text-body">Experience, education and national service.</p></div>
    <ol class="relative border-l border-line lg:col-span-8">
      <% for (const e of timeline) { const period = e.startDate || e.endDate ? periodLabel(e.startDate, e.endDate, e.isCurrent) : (e.periodLabel || (e.isCurrent ? 'Present' : '')); %>
        <li class="relative pb-10 pl-8 reveal">
          <span class="absolute -left-[5px] top-2 size-2.5 rounded-full <%= e.isCurrent ? 'bg-gold' : 'bg-line' %> ring-4 ring-bg"></span>
          <% if (period) { %><p class="mono-label"><%= period %></p><% } %>
          <h3 class="mt-1 text-display-sm"><%= e.role %></h3>
          <p class="mt-1 font-medium text-ink"><%= e.organization %><% if (e.location) { %> <span class="font-normal text-muted">· <%= e.location %></span><% } %></p>
          <% if (e.description) { %><p class="mt-3 max-w-2xl text-[0.95rem]"><%= e.description %></p><% } %>
        </li>
      <% } %>
      <% for (const e of education) { %>
        <li class="relative pb-10 pl-8 reveal">
          <span class="absolute -left-[5px] top-2 size-2.5 rounded-full bg-teal ring-4 ring-bg"></span>
          <p class="mono-label">Education<%= e.startYear || e.endYear ? ' · ' + [e.startYear, e.endYear].filter(Boolean).join(' — ') : '' %></p>
          <h3 class="mt-1 text-display-sm"><%= e.qualification %><%= e.field ? ', ' + e.field : '' %></h3>
          <p class="mt-1 font-medium text-ink"><%= e.institution %></p>
          <% if (e.notes) { %><p class="mt-3 text-[0.95rem]"><%= e.notes %></p><% } %>
        </li>
      <% } %>
    </ol>
  </div>
</section>

<section class="bg-surface py-20" aria-labelledby="approach-h">
  <div class="container-x">
    <%- include('../partials/site/section-head', { kicker: 'Approach', title: 'How I work', id: 'approach-h' }) %>
    <div class="grid gap-8 md:grid-cols-3">
      <% const values = [['target','Start from the outcome','Every engagement begins with what should be different afterwards — fewer hours spent, a team that can run the system, a measurable improvement.'],['shield-check','Boring technology, done well','Well-supported stacks, tested code, plain documentation. Systems your own team can maintain long after I have left.'],['users','Teach while building','Clients get the software and the skills: walkthroughs, handover sessions and training that sticks.']]; %>
      <% values.forEach(([ic, t, d], i) => { %><div class="reveal" style="--i:<%= i %>"><span class="grid size-11 place-items-center rounded-full border border-line text-gold-ink"><%- icon(ic,'size-5') %></span><h3 class="mt-5 text-display-sm"><%= t %></h3><p class="mt-3 text-[0.95rem]"><%= d %></p></div><% }) %>
    </div>
  </div>
</section>

<% if (skills.length) { %>
<section class="container-x py-20" aria-labelledby="stack-h">
  <%- include('../partials/site/section-head', { kicker: 'Toolkit', title: 'Tech stack', intro: 'Grouped by area, with honest self-assessed proficiency.', id: 'stack-h' }) %>
  <div class="grid gap-x-10 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
    <% for (const [cat, list] of skillGroups) { %>
      <div class="reveal">
        <h3 class="mono-label !text-gold-ink"><%= skillLabel(cat) %></h3>
        <ul class="mt-4 grid gap-5" role="list">
          <% list.forEach((k, i) => { %><%- include('../partials/site/skill-bar', { k, i: i % 6 }) %><% }) %>
        </ul>
      </div>
    <% } %>
  </div>
</section>
<% } %>

<% if (press.length) { %>
<section class="container-x py-16" aria-labelledby="press-h">
  <%- include('../partials/site/section-head', { kicker: 'Speaking & press', title: 'On stage and in print', id: 'press-h' }) %>
  <ul class="divide-y divide-line border-y border-line">
    <% for (const p of press) { %>
      <li class="flex flex-wrap items-center gap-x-6 gap-y-1 py-5">
        <span class="mono-label w-28"><%= p.kind %><%= p.date ? ' · ' + String(p.date).slice(0,4) : '' %></span>
        <span class="flex-1 font-display text-lg text-ink"><% if (p.url) { %><a class="link-grow" href="<%= p.url %>" target="_blank" rel="noopener"><%= p.title %></a><% } else { %><%= p.title %><% } %></span>
        <span class="text-muted"><%= p.outlet %></span>
      </li>
    <% } %>
  </ul>
</section>
<% } %>
