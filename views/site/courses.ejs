<%- include('../partials/site/page-hero', { kicker: 'Courses', title: 'Open & upcoming courses', lede: 'Public cohorts you can register for. For private, in-house delivery, request any programme from the training catalogue.' }) %>
<section class="container-x">
  <% if (!courses.length) { %>
    <div class="card px-6 py-16 text-center"><p class="font-display text-2xl text-ink">No public cohorts are open right now.</p><p class="mx-auto mt-3 max-w-lg">New dates are announced in the newsletter. Every programme on the <a class="underline decoration-gold underline-offset-4" href="/training">training page</a> can also be delivered privately for your team.</p><a href="/contact?type=Corporate%20training" class="btn btn-primary mt-8">Request a private cohort</a></div>
  <% } else { %>
  <div class="grid gap-8">
    <% courses.forEach((c, i) => { %>
      <article id="<%= c.slug %>" class="card grid gap-8 p-6 md:p-8 lg:grid-cols-[1fr_22rem] reveal">
        <div>
          <div class="flex flex-wrap items-center gap-2"><% if (c.track) { %><span class="mono-label"><%= c.track.name %></span><% } %><span class="chip <%= c.registrationOpen ? 'chip-teal' : '' %>"><%= c.registrationOpen ? 'Registration open' : 'Registration closed' %></span></div>
          <h2 class="mt-3 text-display-md"><%= c.title %></h2>
          <% if (c.summary) { %><p class="mt-3 text-lede !text-[1.05rem]"><%= c.summary %></p><% } %>
          <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-3 text-sm">
            <% if (c.startDate) { %><div><dt class="mono-label">Starts</dt><dd class="text-ink"><%= formatDate(c.startDate) %></dd></div><% } %>
            <% if (pub(c.durationLabel)) { %><div><dt class="mono-label">Duration</dt><dd class="text-ink"><%= c.durationLabel %></dd></div><% } %>
            <% if (pub(c.scheduleLabel)) { %><div><dt class="mono-label">Schedule</dt><dd class="text-ink"><%= c.scheduleLabel %></dd></div><% } %>
            <div><dt class="mono-label">Fee</dt><dd class="text-ink"><%= formatMoney(c.price, c.currency) %></dd></div>
            <% if (c.seats) { %><div><dt class="mono-label">Seats</dt><dd class="text-ink"><%= c.seats %></dd></div><% } %>
          </dl>
          <% if ((c.outline || []).length) { %><details class="mt-6"><summary class="cursor-pointer font-medium text-ink">Course outline</summary><ol class="mt-3 list-decimal pl-5 text-[0.95rem]"><% c.outline.forEach(o => { %><li class="mt-1"><%= o %></li><% }) %></ol></details><% } %>
          <% if (c.bodyHtml) { %><div class="prose mt-6"><%- c.bodyHtml %></div><% } %>
        </div>
        <div>
          <% if (c.registrationOpen) { %>
            <div data-form-success tabindex="-1" hidden></div>
            <form method="post" action="/courses/<%= c.slug %>/register" class="grid gap-3" data-ajax-form data-event="course_registration">
              <h3 class="font-display text-lg text-ink">Register interest</h3>
              <%- include('../partials/site/antispam') %>
              <%- include('../partials/site/field', { name: 'name', label: 'Name', required: true, autocomplete: 'name' }) %>
              <%- include('../partials/site/field', { name: 'email', label: 'Email', type: 'email', required: true, autocomplete: 'email' }) %>
              <%- include('../partials/site/field', { name: 'phone', label: 'Phone', type: 'tel', autocomplete: 'tel' }) %>
              <%- include('../partials/site/field', { name: 'seats', label: 'Seats', type: 'number', placeholder: '1' }) %>
              <button class="btn btn-primary" type="submit">Register</button>
              <p class="text-sm" data-form-status role="status" aria-live="polite"></p>
            </form>
          <% } else { %><p class="text-sm">Registration is closed. <a class="underline" href="/contact?subject=<%= encodeURIComponent(c.title) %>">Ask about future dates</a>.</p><% } %>
        </div>
      </article>
    <% }) %>
  </div>
  <% } %>
</section>
