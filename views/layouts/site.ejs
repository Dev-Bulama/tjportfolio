<!doctype html>
<html lang="en" class="no-js" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= meta.title %></title>
<meta name="description" content="<%= meta.description %>">
<link rel="canonical" href="<%= meta.canonical %>">
<% if (meta.noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
<meta property="og:type" content="<%= meta.type %>">
<meta property="og:site_name" content="<%= meta.siteName %>">
<meta property="og:title" content="<%= meta.title %>">
<meta property="og:description" content="<%= meta.description %>">
<meta property="og:url" content="<%= meta.canonical %>">
<meta property="og:image" content="<%= meta.image %>">
<meta property="og:image:alt" content="<%= meta.imageAlt %>">
<% if (meta.publishedTime) { %><meta property="article:published_time" content="<%= meta.publishedTime %>"><% } %>
<meta name="twitter:card" content="summary_large_image">
<% if (meta.twitter) { %><meta name="twitter:site" content="<%= meta.twitter %>"><% } %>
<% if (meta.gsc) { %><meta name="google-site-verification" content="<%= meta.gsc %>"><% } %>
<meta name="theme-color" content="#0F2A47">
<link rel="icon" href="<%= brand.favicon ? mediaUrl(brand.favicon, 320) : '/favicon.svg' %>" <% if (!brand.favicon) { %>type="image/svg+xml"<% } %>>
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="alternate" type="application/rss+xml" title="Insights — <%= profile.fullName %>" href="/rss.xml">
<link rel="preload" href="/fonts/fraunces-opsz.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/inter-opsz.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="<%= asset('/assets/app.css') %>">
<% if (accent) { %><style>:root{--gold:<%= accent %>}</style><% } %>
<script nonce="<%= nonce %>">(function(){var d=document.documentElement;d.classList.remove('no-js');var t=null;try{t=localStorage.getItem('theme')}catch(e){}if(t!=='light'&&t!=='dark'){t=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}d.dataset.theme=t;})();</script>
<% for (const ld of meta.jsonLd) { %><script type="application/ld+json" nonce="<%= nonce %>"><%- json(ld) %></script>
<% } %>
<% if (settings.seo.ga4Id && /^G-[A-Z0-9]+$/.test(settings.seo.ga4Id)) { %>
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= settings.seo.ga4Id %>" nonce="<%= nonce %>"></script>
<script nonce="<%= nonce %>">window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','<%= settings.seo.ga4Id %>',{anonymize_ip:true});</script>
<% } %>
</head>
<body class="bg-bg text-body">
<a class="skip-link" href="#main">Skip to content</a>
<%- include('../partials/site/header') %>
<main id="main" tabindex="-1" class="outline-none">
<%- body %>
</main>
<%- include('../partials/site/footer') %>
<script type="module" src="<%= asset('/assets/site.js') %>" nonce="<%= nonce %>"></script>
</body>
</html>
