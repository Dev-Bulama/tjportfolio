# ── Core ────────────────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
# PORT is normally provided by the host; 3000 is used if it isn't.
PORT=3000
APP_URL=https://yourdomain.com
# Admin lives at /<ADMIN_PATH>. Change it to something less guessable to reduce bot noise.
ADMIN_PATH=admin
# 64+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# One-time token for /setup?token=…  Delete this variable after the Owner account exists.
SETUP_TOKEN=

# ── Database (Hostinger: hPanel → Databases → MySQL Databases; host is usually localhost) ───────
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
# Keep this small on shared hosting (connection limits). 1–10.
DATABASE_POOL_SIZE=5

# ── Uploads ─────────────────────────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local       # local | s3
# Absolute path OUTSIDE the app folder so uploads survive redeploys, e.g. /home/u123456789/portfolio-storage
UPLOAD_DIR=
# S3-compatible storage (Cloudflare R2 recommended). Only needed when STORAGE_DRIVER=s3.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket (custom domain or r2.dev URL). Leave empty to serve files through the app.
S3_PUBLIC_URL=

# ── Email (Hostinger mailbox) ───────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=                 # e.g. hello@yourdomain.com
SMTP_PASSWORD=
MAIL_FROM="Tijani Bulama <hello@yourdomain.com>"
# Where new messages, tickets and reviews are announced (defaults to SMTP_USER).
ADMIN_NOTIFY_EMAIL=

# ── Anti-spam (Cloudflare Turnstile). Optional: honeypot + rate limiting are always on. ─────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Scheduled jobs & analytics ──────────────────────────────────────────────────────────────────
# Secret for GET /api/cron?secret=…&task=all
CRON_SECRET=
# Random string used to hash visitors (rotates daily). Never share it.
ANALYTICS_SALT=

# ── Optional ────────────────────────────────────────────────────────────────────────────────────
# Number of proxies in front of the app (Hostinger: 1). Used to read the real client IP for rate limiting.
TRUST_PROXY=1
LOG_LEVEL=info
